# 环境变量示例

# 数据库配置
DATABASE_URL=sqlite:///./moodwave.db

# 后端 AI 配置（请在本地/CloudBase 中填写真实值，不要提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_ASR_MODEL=qwen3-asr-flash
APP_ENV=development
APP_SECRET_KEY=

# 邮箱验证码 SMTP 配置
# Brevo / QQ 邮箱 / 网易邮箱 / Gmail 都可以，只要能 SMTP 发信。
# QQ、网易、Gmail 通常要填“SMTP 授权码/应用专用密码”，不是邮箱登录密码。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false

# 网易个人邮箱示例：
# @163.com: SMTP_HOST=smtp.163.com, SMTP_PORT=465, SMTP_SSL=true, SMTP_TLS=false
# @126.com: SMTP_HOST=smtp.126.com, SMTP_PORT=465, SMTP_SSL=true, SMTP_TLS=false
# @yeah.net: SMTP_HOST=smtp.yeah.net, SMTP_PORT=465, SMTP_SSL=true, SMTP_TLS=false

# API 配置
NEXT_PUBLIC_API_URL=http://localhost:8000

# Python 配置
PYTHONUNBUFFERED=1
