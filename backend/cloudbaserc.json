{
  "version": "2.0",
  "envId": "moodwave-d1goq3vwib5df0121",
  "region": "ap-shanghai",
  "framework": {
    "name": "moodwave-backend",
    "plugins": {
      "container": {
        "use": "@cloudbase/framework-plugin-container",
        "inputs": {
          "serviceName": "moodwave-backend",
          "servicePath": ".",
          "containerPort": 8000,
          "dockerfile": "Dockerfile.cloudrun",
          "cpu": 0.5,
          "mem": 1,
          "minNum": 1,
          "maxNum": 3
        }
      }
    }
  }
}
